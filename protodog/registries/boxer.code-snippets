{
	// Family: standalone Boxer prompt family.
	// Mechanical style: ../skills/agentic-execution-protocol/references/prompt-registry-style.md.
	// Semantics and local XML dialect remain Boxer-owned; entries below are extracted verbatim.
	"BoxerUI Page: Interactive routed page": {
		"scope": "markdown",
		"prefix": "bx-page",
		"body": [
			"<prompt>",
			"  <task>${1:One sentence: what to scaffold.}</task>",
			"",
			"  <files>",
			"    - Components/Pages/${2:Page}.razor",
			"  </files>",
			"  <route>${3:/url/pattern}</route>",
			"",
			"  <composition>${4:Shell, layout choices, feedback surfaces.}</composition>",
			"",
			"  <components>",
			"    <required>${5:ComponentA, ComponentB}</required>",
			"    <suggested>${6:Components or services worth reaching for per region.}</suggested>",
			"  </components>",
			"",
			"  <forbidden>",
			"    - ${7:An architectural choice ruled out for this page — never library policy.}",
			"  </forbidden>",
			"",
			"  <data>",
			"    <service>${8:IExampleService.MethodAsync(args) → ReturnDto}</service>",
			"    <model>${9:ExampleDto}</model>",
			"    <ownership>${10:Who owns mutable state — local / scoped service / cascading value — and its refresh or disposal policy.}</ownership>",
			"  </data>",
			"",
			"  <behavior>",
			"    - ${11:One interaction or state transition per bullet — including its accessibility decisions.}",
			"  </behavior>",
			"",
			"  <assert>",
			"    - ${12:One browser-observable assertion per bullet.}",
			"  </assert>",
			"",
			"  <guardrails>",
			"    - Read applicable repository instructions, BoxerUI catalog guidance, and target files before editing; preserve unrelated and intervening human changes.",
			"    - Do not add packages or perform external/destructive actions without approval. Verify each assertion with the available test harness; report anything unverified.",
			"    - Never reproduce secret values in responses, logs, reports, durable artefacts, or transmitted data; identify only their type and location, and redact them.",
			"    - Do not transmit personal/customer/production data, proprietary material, or regulated data to external services without approval; when authorized, minimize and redact the data.",
			"  </guardrails>",
			"</prompt>",
			"$0"
		],
		"description": "Routed-page prompt; render_mode omitted ⇒ InteractiveServer"
	},
