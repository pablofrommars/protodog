			"<files>",
			"  - ${1:Components/Pages/Page.razor}",
			"</files>",
			"<route>${2:/url/pattern}</route>",
			"$0"
		],
		"description": "Deliverable files + route; <route> present ⇒ routed page — drop it for an app-local component"
	},
	"BoxerUI Tag: render_mode Static": {
		"scope": "markdown",
		"prefix": "bx-render-static",
		"body": [
			"<render_mode>Static</render_mode>",
			"$0"
		],
		"description": "Declare only Static — omitted ⇒ InteractiveServer"
	},
	// ============================================================
	// C. MAINTENANCE / AUDIT
	// ============================================================
	"BoxerUI Audit: catalog invariants": {
		"scope": "markdown",
		"prefix": "bx-audit-catalog",
		"body": [
			"<task>",
			"Audit ${1:the whole catalog} against the invariants in `${2:path/to/README.md}` § \"Catalog invariants\". Read the listed catalog/style/component files from that repository; do not infer paths or rules from memory. Report findings only — no fixes.",
			"</task>",
			"",
			"<output_format>",
			"One row per violation: invariant · component · file/field · what's wrong. End with a per-invariant pass/fail tally, and name any invariant you could not check.",
			"</output_format>",
			"$0"
		],
		"description": "Verify catalog invariants from an explicit README path; scope $1 down to one component when needed"
	}
}
