	"BoxerUI Tag: composition": {
		"scope": "markdown",
		"prefix": "bx-composition",
		"body": [
			"<composition>${1:Layout intent in plain terms: shell, layout choices, feedback surfaces — never a pattern-recipe name.}</composition>",
			"$0"
		],
		"description": "Layout intent; the composing agent selects recipes during decomposition"
	},
	"BoxerUI Tag: components": {
		"scope": "markdown",
		"prefix": "bx-components",
		"body": [
			"<components>",
			"  <required>${1:ComponentA, ComponentB}</required>",
			"  <suggested>${2:Components or services worth reaching for per region.}</suggested>",
			"</components>",
			"$0"
		],
		"description": "Names are components.json lookup keys. Either list may be omitted; add the `closed` attribute when nothing outside the lists may render (rare; audits)"
	},
