{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [{ "type": "command", "command": "dotnet \"${CLAUDE_PLUGIN_ROOT}\"/hooks/protodog-hooks.cs pre-bash" }]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [{ "type": "command", "command": "dotnet \"${CLAUDE_PLUGIN_ROOT}\"/hooks/protodog-hooks.cs pre-write" }]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [{ "type": "command", "command": "dotnet \"${CLAUDE_PLUGIN_ROOT}\"/hooks/protodog-hooks.cs post-plan-write" }]
      }
    ]
  }
}
